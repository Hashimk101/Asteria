# Environment Configuration Example for Asteria Backend

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:your_password@db.vdzikrxzjrvsvqnsihiq.supabase.co:5432/postgres

# NASA API Key (from NeoWs)
NASA_API_KEY=your_nasa_api_key_here

# Server Port (optional, default 8000)
PORT=8000

# CORS Allowed Origins (comma-separated or * for all)
CORS_ORIGINS=*
